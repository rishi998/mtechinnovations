# Server
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed browser origins (your Next.js URL on Render).
# Example: https://your-frontend.onrender.com
# Omit or leave empty to reflect the request origin (useful for local dev only).
CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/clientecomm

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Razorpay (optional)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Zoho (optional — see backend README)
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_ORGANIZATION_ID=
# ZOHO_REDIRECT_URI=
